[Unit]
Description=Pi-hole touchscreen dashboard backend (localhost only)
Documentation=file:///opt/pihole-dash/README.md
# Ordering only: this never starts, stops or restarts pihole-FTL.
After=network-online.target pihole-FTL.service
Wants=network-online.target

[Service]
Type=simple
User=pihole-dash
Group=pihole-dash
ExecStart=/usr/bin/python3 -I /opt/pihole-dash/backend/pihole_dash.py
Environment=PIHOLE_URL=http://127.0.0.1 BIND=127.0.0.1 PORT=8088 WWW_DIR=/opt/pihole-dash/www

# The app password lives in a root-owned 0600 file. systemd (as root) reads it and
# hands a private copy to this unprivileged service. If the file is missing,
# SetCredential supplies a placeholder and the dashboard shows "Needs setup".
LoadCredential=app-password:/etc/pihole-dash/app-password
SetCredential=app-password:__MISSING__

Restart=always
RestartSec=5

# Hardening: no privileges, read-only system, no home dirs, localhost network only.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
IPAddressAllow=localhost
IPAddressDeny=any
MemoryMax=96M

[Install]
WantedBy=multi-user.target
